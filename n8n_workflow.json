{
  "name": "Grievance Auto-Resolution",
  "nodes": [
    {"parameters": {"pollTimes": {"item": [{"mode": "everyMinute"}]}, "simple": true, "filters": {"labelIds": ["INBOX"], "readStatus": "unread"}},
     "name": "Gmail Trigger", "type": "n8n-nodes-base.gmailTrigger", "typeVersion": 1.2, "position": [0, 0]},
    {"parameters": {"method": "POST", "url": "http://api:8000/grievance", "sendHeaders": true,
       "headerParameters": {"parameters": [{"name": "X-API-Key", "value": "change-me"}]},
       "sendBody": true, "specifyBody": "json",
       "jsonBody": "={{ JSON.stringify({text: $json.subject + '\\n' + ($json.text || $json.snippet), source: 'n8n', ref: $json.id}) }}"},
     "name": "RAG API", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [260, 0]},
    {"parameters": {"conditions": {"options": {"caseSensitive": true, "typeValidation": "strict"}, "combinator": "and",
       "conditions": [{"leftValue": "={{ $json.status }}", "rightValue": "new", "operator": {"type": "string", "operation": "equals"}}]}},
     "name": "Confident?", "type": "n8n-nodes-base.if", "typeVersion": 2, "position": [520, 0]},
    {"parameters": {"operation": "reply", "messageId": "={{ $('Gmail Trigger').item.json.id }}", "message": "={{ $json.reply }}", "options": {}},
     "name": "Gmail Reply", "type": "n8n-nodes-base.gmail", "typeVersion": 2.1, "position": [780, -80]},
    {"parameters": {"method": "POST", "url": "=http://api:8000/tickets/{{ $('RAG API').item.json.id }}/approve", "sendHeaders": true,
       "headerParameters": {"parameters": [{"name": "X-API-Key", "value": "change-me"}]}},
     "name": "Mark Resolved", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [1040, -80]}
  ],
  "connections": {
    "Gmail Trigger": {"main": [[{"node": "RAG API", "type": "main", "index": 0}]]},
    "RAG API": {"main": [[{"node": "Confident?", "type": "main", "index": 0}]]},
    "Confident?": {"main": [[{"node": "Gmail Reply", "type": "main", "index": 0}], []]},
    "Gmail Reply": {"main": [[{"node": "Mark Resolved", "type": "main", "index": 0}]]}
  }
}
